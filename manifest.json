{
    "name": "Purrfect Pomodoro Timer: Productivity & Time Management",
    "version": "1.2.6",
    "description": "Purrfect Pomodoro Timer",
    "permissions": ["storage", "notifications", "alarms"],
    "background": {
      "service_worker": "modules/background.js",
      "type": "module"
    },
    "action": {
      "default_icon": {
        "16": "assets/cat.png",
        "24": "assets/cat.png",
        "32": "assets/cat.png",
        "48": "assets/cat.png",
        "128": "assets/cat.png"
      },
      "default_title": "Purrfect Pomodoro Timer",
      "default_popup": "modules/popup/popup.html"
    },
    "icons": {
        "16": "assets/cat.png",
        "24": "assets/cat.png",
        "32": "assets/cat.png",
        "48": "assets/cat.png",
        "128": "assets/cat.png"
    },
    "manifest_version": 3,
    "commands": {
    "start_timer": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Start Pomodoro Timer"
    },
    "pause_timer": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Pause Pomodoro Timer"
    },
    "open_popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open Pomodoro Popup"
    }
  }
}
