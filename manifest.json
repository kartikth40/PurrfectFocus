{
    "name": "Purrfect Focus",
    "version": "0.1.4",
    "description": "Purrfect Focus: Cat & Pomodoro Pal",
    "permissions": ["storage", "notifications"],
    "background": {
      "service_worker": "modules/background.js",
      "type": "module"
    },
    "action": {
      "default_icon": {
        "48": "assets/cat_small.png",
        "16": "assets/cat_small.png",
        "24": "assets/cat_small.png",
        "32": "assets/cat_small.png"
      },
      "default_title": "Purrfect Focus",
      "default_popup": "modules/popup/popup.html"
    },
    "manifest_version": 3
}
