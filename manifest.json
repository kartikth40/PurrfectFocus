{
    "name": "Purrfect Focus",
    "version": "0.1",
    "description": "Purrfect Focus: Cat & Pomodoro Pal",
    "permissions": ["storage", "tabs", "notifications"],
    "background": {
      "service_worker": "modules/background.js",
      "type": "module"
    },
    "content_scripts": [
      {
        "js": ["modules/contentScript.js"],
        "matches":["<all_urls>"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/cat.png"
        ],
        "matches":["<all_urls>"]
      }
    ],
    "action": {
      "default_icon": {
        "16": "assets/cat.png",
        "24": "assets/cat.png",
        "32": "assets/cat.png"
      },
      "default_title": "Purrfect Focus",
      "default_popup": "modules/popup/popup.html"
    },
    "manifest_version": 3
}
